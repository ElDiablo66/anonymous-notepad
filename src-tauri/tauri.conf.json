{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anonymous Notepad",
  "version": "0.1.0",
  "identifier": "app.anonymousnotepad.desktop",
  "build": {
    "devUrl": "http://localhost:5184",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Anonymous Notepad",
        "width": 1240,
        "height": 800,
        "minWidth": 720,
        "minHeight": 420,
        "theme": "Dark",
        "backgroundColor": "#1a0f35",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "El Diablo 59",
    "shortDescription": "Text and code editor with a neon sunset look",
    "longDescription": "Anonymous Notepad is a text and code editor with tabs, session restore, search across files, line tools and syntax colours for more than a hundred languages.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    },
    "copyright": "Copyright 2026 El Diablo 59"
  }
}
